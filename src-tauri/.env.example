# Strazh — Nebius Token Factory (NVIDIA Nemotron) configuration
# Copy this file to `.env` and fill in your key. `.env` is gitignored.

# Required: your Nebius Token Factory API key.
NEBIUS_API_KEY=

# Optional: override the base URL (defaults to the public Token Factory endpoint).
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional: override the NVIDIA Nemotron model id (default: nvidia/Nemotron-3_5-Lightning).
# NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
